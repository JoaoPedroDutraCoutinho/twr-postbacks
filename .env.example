# Porta do servidor HTTP
PORT=3000

# Ambiente de execução (development | test | production)
NODE_ENV=development

# Conexão com o banco PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/twr_postbacks

# Segredo compartilhado para validação HMAC-SHA256 dos webhooks
WEBHOOK_SECRET=twr_webhook_secret_key_2026
