{
  "name": "twr-postbacks",
  "version": "1.0.0",
  "description": "Receptor de postbacks de vendas de checkout com garantia de idempotência, assinatura HMAC e relatórios analíticos",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/observability/tracing.ts src/server.ts",
    "build": "tsc && node --input-type=module -e \"import fs from 'node:fs'; fs.cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true });\"",
    "start": "node --import ./dist/observability/tracing.js dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "tsx scripts/simulate.ts",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "keywords": [
    "webhooks",
    "postbacks",
    "fastify",
    "typescript",
    "idempotency",
    "hmac",
    "postgresql"
  ],
  "author": "João Pedro Dutra Coutinho",
  "license": "MIT",
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "dotenv": "^18.0.0",
    "fastify": "^5.7.4",
    "pg": "^8.19.1",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
